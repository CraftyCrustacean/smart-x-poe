{
  "MqttSettings": {
    "MqttHost": "mosquitto",
    "MqttPort": "1883"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Npgsql": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Thresholds": {
    "ElevationChangeMm": { "Normal": 0.0, "Critical": -8.0 },
    "SurfaceTemperatureC": { "Normal": 18.0, "Critical": 23.0 },
    "ColourShiftIndex": { "Normal": 0.0, "Critical": -0.35 },
    "FlowRateLps": { "Normal": 100.0, "Critical": 85.0 }
  },

  "Search": { "LowBatteryPct": 20 }
}
